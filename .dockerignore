.gitignore
.venv
.env
.env.*
!.env.example
.pytest_cache
**/__pycache__
**/*.py[oc]
data
logs
*.db
notebooks
tests
Dockerfile
docker-compose.yml
.dockerignore
*.md
!README.md
LICENSE
Makefile

