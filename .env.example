# Path to the SQLite database file used by it_tickets
TICKETS_DB_PATH=./data/tickets.db

# OpenAI settings used by the IT support agent (ticket_agent)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
OPENAI_REASONING_EFFORT=high

# REST API server (defaults shown)
API_HOST=0.0.0.0
API_PORT=8000
LOG_DIR=./logs
LOG_LEVEL=INFO

# Reverse proxy (set by docker-compose when the API runs behind nginx)
# API_ROOT_PATH=/api
# FORWARDED_ALLOW_IPS=127.0.0.1
# PUBLIC_BASE_URL=http://localhost/api
